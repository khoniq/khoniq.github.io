#!/bin/sh
set -eu

# ---- load config ----
. ./data/conf

mkdir -p "$pub" "$temp" "$data"

# ---- helpers ----
extract_title() {
  # 取第一個 <h1>...</h1> 的純文字
  # 找不到就回傳 conf 的 title
  t="$(grep -m 1 '<h1>' "$1" 2>/dev/null | sed 's/.*<h1[^>]*>//; s/<\/h1>.*//; s/^[[:space:]]*//; s/[[:space:]]*$//')"
  if [ -n "${t:-}" ]; then
    printf "%s" "$t"
  else
    printf "%s" "$title"
  fi
}

escape_sed_repl() {
  # 逃逸 sed replacement 會炸的字元：\  &  |
  # 用 | 當分隔符
  printf '%s' "$1" | sed 's/[\\&|]/\\&/g'
}

rfc2822_date() {
  # Linux: date -R -d "@epoch"
  # macOS: date -r epoch "+%a, %d %b %Y %H:%M:%S %z"
  if date -R -d "@$1" >/dev/null 2>&1; then
    date -R -d "@$1"
  else
    date -r "$1" "+%a, %d %b %Y %H:%M:%S %z"
  fi
}

url_from_rel() {
  rel="$1"
  case "$rel" in
    */index.html) printf "/%s" "$(printf "%s" "$rel" | sed 's/index\.html$//')" ;;
    *)           printf "/%s" "$rel" ;;
  esac
}

# ---- step 1: generate man/journal/index.html (source-level index) ----
if [ -x ./journal_update ]; then
  ./journal_update || true
fi

# ---- step 2: build all pages ----
weblog_tmp="$data/weblog.tmp"
: > "$weblog_tmp"


# man 底下所有 .html 都套模板輸出
find "$man" -type f -name '*.html' | while IFS= read -r src; do
  rel="${src#$man/}"
  out="$pub/$rel"
  out_dir="$(dirname "$out")"
  mkdir -p "$out_dir"

  page_title="$(extract_title "$src")"

  # 產生臨時 head（把 <!--title--> 換掉）
  head_tmp="$temp/head.tmp.html"
safe_title="$(escape_sed_repl "$page_title")"
sed "s|<!--title-->|$safe_title|g" "$header" > "$head_tmp"

  cat "$head_tmp" "$src" "$footer" > "$out"

  # 記錄更新時間（用輸出檔 mtime）
  if stat -c %Y "$out" >/dev/null 2>&1; then
    epoch="$(stat -c %Y "$out")"
  else
    epoch="$(stat -f %m "$out")"
  fi

  page_url="$(url_from_rel "$rel")"
  printf "%s %s\n" "$epoch" "$page_url" >> "$weblog_tmp"
done

# 整理 weblog：時間新到舊
sort -nr "$weblog_tmp" > "$data/weblog"
rm -f "$weblog_tmp"

# ---- step 3: generate RSS (pub/rss.xml) from 首頁「更新履歴」 ----
# 只收錄 man/index.html 裡「更新履歴」清單的文章：
#   <li>YYYY-MM-DD <a href="/路徑">標題</a></li>
rss_out="$pub/rss.xml"
max_items=30

rss_date() {
  # YYYY-MM-DD -> RFC 2822（台灣時間 00:00）
  if [ "$(uname)" = Darwin ]; then
    LC_ALL=C date -j -f "%Y-%m-%d" "$1" "+%a, %d %b %Y 00:00:00 +0800"
  else
    LC_ALL=C date -d "$1" "+%a, %d %b %Y 00:00:00 +0800"
  fi
}

{
  echo '<?xml version="1.0" encoding="UTF-8"?>'
  echo '<rss version="2.0">'
  echo '<channel>'
  echo "  <title>$title</title>"
  echo "  <link>$url/</link>"
  echo "  <description>$rss_description</description>"
  echo "  <language>zh-Hant</language>"

  awk '/更新履歴/{f=1} f&&/<\/ul>/{exit} f' "$man/index.html" |
  grep '<li>' |
  sed -n 's#.*<li>[[:space:]]*\([0-9-]\{10\}\)[[:space:]]*<a href="\([^"]*\)">\(.*\)</a>.*#\1	\2	\3#p' |
  head -n "$max_items" |
  while IFS='	' read -r d path t; do
    echo "  <item>"
    echo "    <title>$t</title>"
    echo "    <link>$url$path</link>"
    echo "    <guid>$url$path</guid>"
    echo "    <pubDate>$(rss_date "$d")</pubDate>"
    echo "  </item>"
  done

  echo '</channel>'
  echo '</rss>'
} > "$rss_out"

echo "Built: $pub (and RSS: $rss_out)"
